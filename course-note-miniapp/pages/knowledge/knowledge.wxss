/** AI知识库页面 - iOS 极简风格 **/

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 260rpx;
  background: #F5F5F7;
  box-sizing: border-box;
}

/* 聊天模式下页面固定高度，仅聊天记录滚动 */
.page-chat {
  height: 100vh;
  min-height: auto;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.page-chat .chat-section {
  flex: 1;
  min-height: 0;
}

.page-chat .chat-messages {
  flex: 1;
  min-height: 0;
  height: 100%;
}

.header {
  background: #FFFFFF;
  padding: 30rpx 30rpx 20rpx;
  color: #1D1D1F;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.025em;
  display: block;
}

.header-sub {
  font-size: 24rpx;
  color: #86868B;
  margin-top: 6rpx;
  display: block;
}

/* 课程横向选择条 */
.course-bar {
  background: #FFFFFF;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  white-space: nowrap;
}

.course-bar-inner {
  display: inline-flex;
  padding: 0 80rpx 0 20rpx;
  gap: 12rpx;
}

.course-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 24rpx;
  background: #F5F5F7;
  border-radius: 30rpx;
  transition: all 0.2s;
  border: 2rpx solid transparent;
}

.course-chip.active {
  background: rgba(10, 132, 255, 0.14);
  border-color: #0A84FF;
  box-shadow: 0 4rpx 12rpx rgba(10, 132, 255, 0.12);
}

.chip-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.chip-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1D1D1F;
  white-space: nowrap;
}

.course-chip.active .chip-name {
  color: #0A84FF;
}

/* Tab切换 - 底部线条样式 */
.kb-tabs {
  display: flex;
  margin: 20rpx 30rpx 0;
  background: transparent;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.kb-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #86868B;
  position: relative;
  transition: all 0.2s;
}

.kb-tab.active {
  color: #0A84FF;
  font-weight: 600;
}

.kb-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #0A84FF;
  border-radius: 2rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
  display: block;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 10rpx;
  display: block;
}

.empty-desc {
  font-size: 24rpx;
  color: #86868B;
  display: block;
}

/* AI对话区域 */
.chat-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin: 0 30rpx;
  min-height: 0;
}

.kb-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 30rpx 0;
}

.kb-loading-text {
  font-size: 24rpx;
  color: #86868B;
}

.kb-loading .loading-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.kb-loading .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #0A84FF;
  animation: dotPulse 1.4s infinite ease-in-out both;
}

.chat-messages {
  flex: 1;
  min-height: 0;
  padding: 20rpx 0 0;
  overflow-y: auto;
}

.chat-messages-inner {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.chat-msg {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.chat-msg.user {
  flex-direction: row-reverse;
}

.chat-msg.assistant {
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.chat-msg.assistant .msg-avatar {
  width: 52rpx;
  height: 52rpx;
  font-size: 22rpx;
}

.msg-avatar.assistant {
  background: #0A84FF;
  color: #FFFFFF;
}

.msg-avatar.user {
  background: #E5E5EA;
  color: #1D1D1F;
}

.msg-bubble {
  max-width: calc(100% - 100rpx);
  padding: 18rpx 24rpx;
  border-radius: 22rpx;
  font-size: 26rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.chat-msg.assistant .msg-bubble {
  max-width: 100%;
  background: #FFFFFF;
  color: #1D1D1F;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  border-top-left-radius: 6rpx;
}

.chat-msg.user .msg-bubble {
  background: #0A84FF;
  color: #FFFFFF;
  border-top-right-radius: 6rpx;
}

.msg-loading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #86868B;
  margin-top: 8rpx;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #0A84FF;
  animation: dotPulse 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes dotPulse {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

/* 快捷问题 */
.quick-questions {
  padding: 10rpx 0 20rpx;
}

.quick-title {
  font-size: 22rpx;
  color: #86868B;
  margin-bottom: 12rpx;
  display: block;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-chip {
  width: calc(50% - 6rpx);
  padding: 14rpx 20rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #1D1D1F;
  transition: all 0.2s;
  box-sizing: border-box;
  text-align: center;
}

.quick-chip:active {
  background: #0A84FF;
  color: #FFFFFF;
  border-color: #0A84FF;
}

/* 聊天输入 - 固定底部 */
.chat-input-area {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  padding: 16rpx 0;
  background: #F5F5F7;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  z-index: 10;
}

.chat-input-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.send-btn {
  width: 100rpx;
  height: 72rpx;
  background: #D1D1D6;
  color: #FFFFFF;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s;
  flex-shrink: 0;
}

.send-btn.active {
  background: #0A84FF;
}

.send-btn:active {
  opacity: 0.85;
}

/* 文档区域 */
.doc-section {
  margin: 0 30rpx 40rpx;
  padding-bottom: 40rpx;
}

.doc-search {
  margin-bottom: 16rpx;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 0 24rpx;
  height: 72rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.search-icon {
  font-size: 28rpx;
  color: #86868B;
}

.doc-search-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
  color: #1D1D1F;
}

.doc-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  transition: all 0.2s;
  position: relative;
}

.doc-item:active {
  background: #FAFAFA;
}

.doc-delete {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 59, 48, 0.08);
  flex-shrink: 0;
  margin-left: auto;
}

.doc-delete:active {
  background: rgba(255, 59, 48, 0.16);
}

.delete-icon {
  font-size: 30rpx;
  color: #FF3B30;
}

.doc-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
}

.doc-info {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
  box-sizing: border-box;
}

.doc-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.doc-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.doc-status {
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.doc-summary {
  font-size: 24rpx;
  color: #86868B;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.doc-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.doc-time, .doc-size {
  font-size: 20rpx;
  color: #AEAEB2;
}

/* 悬浮上传按钮 */
.fab-upload {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #0A84FF;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(10, 132, 255, 0.35);
  z-index: 100;
  transition: all 0.2s;
}

.fab-upload:active {
  transform: scale(0.92);
}

.fab-icon {
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}
