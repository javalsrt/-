/** 课程管理/添加页 - iOS 极简风格 **/

.page {
  min-height: 100vh;
  background: #F5F5F7;
}

.header {
  background: #FFFFFF;
  padding: 30rpx;
  color: #1D1D1F;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.025em;
}

.course-form {
  margin: 20rpx 30rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #86868B;
  display: block;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
  height: 80rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1D1D1F;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
}

.picker-value {
  height: 80rpx;
  line-height: 80rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  color: #1D1D1F;
  box-sizing: border-box;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-item.half {
  flex: 1;
}

.form-actions {
  margin-top: 30rpx;
}

.form-submit {
  padding: 22rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: #1D1D1F;
  color: #FFFFFF;
  font-weight: 500;
  text-align: center;
}

.form-submit:active {
  opacity: 0.85;
}

.form-delete {
  text-align: center;
  color: #FF3B30;
  border: 2rpx solid rgba(255, 59, 48, 0.2);
  border-radius: 16rpx;
  padding: 22rpx;
  background: rgba(255, 59, 48, 0.05);
  font-weight: 500;
}

.course-list {
  padding: 20rpx 30rpx;
}

.add-course-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 30rpx;
  border: 2rpx dashed rgba(0, 0, 0, 0.1);
  background: #FFFFFF;
  color: #0A84FF;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  font-weight: 500;
}

.add-icon {
  font-size: 36rpx;
  font-weight: bold;
}

.add-text {
  font-size: 28rpx;
}

.course-manage-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 12rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.course-manage-info {
  flex: 1;
}

.course-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
}

.course-detail, .course-time {
  font-size: 24rpx;
  color: #86868B;
  display: block;
  margin-top: 4rpx;
}

.edit-icon {
  font-size: 28rpx;
  color: #C7C7CC;
}
