/** 资料详情页 - iOS 极简风格 **/

.page {
  min-height: 100vh;
  background: #F5F5F7;
  padding-bottom: 130rpx;
}

.material-header {
  background: #1D1D1F;
  padding: 30rpx;
  color: #FFFFFF;
}

.back-btn {
  font-size: 26rpx;
  margin-bottom: 16rpx;
  opacity: 0.9;
  color: #FFFFFF;
}

.mat-type {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.mat-title {
  font-size: 34rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 6rpx;
  letter-spacing: -0.02em;
}

.mat-time {
  font-size: 22rpx;
  opacity: 0.8;
}

.content-section {
  margin: 20rpx 30rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.mat-image {
  width: 100%;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.mat-content {
  font-size: 28rpx;
  color: #1D1D1F;
  line-height: 1.8;
  padding: 16rpx 0;
  white-space: pre-wrap;
}

.tags-section {
  margin: 0 30rpx 20rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 30rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

.action-btn {
  flex: 1;
  padding: 18rpx;
  background: #1D1D1F;
  color: #FFFFFF;
  text-align: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn:active {
  opacity: 0.85;
}

.action-btn.secondary {
  background: #FFFFFF;
  color: #FF3B30;
  border: 2rpx solid rgba(255, 59, 48, 0.2);
}

.action-btn.secondary:active {
  background: rgba(255, 59, 48, 0.05);
}
