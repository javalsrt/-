/** 课段详情页 - iOS 极简风格 **/

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F5F7;
}

.session-header {
  background: #1D1D1F;
  color: #FFFFFF;
  padding: 30rpx 30rpx 40rpx;
  position: relative;
}

.back-btn {
  font-size: 28rpx;
  margin-bottom: 20rpx;
  opacity: 0.9;
}

.back-btn text {
  color: #FFFFFF;
}

.session-course-name {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  letter-spacing: -0.02em;
}

.session-date {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 4rpx;
}

.session-time {
  font-size: 24rpx;
  opacity: 0.8;
}

.session-summary {
  margin-top: 16rpx;
  display: inline-block;
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  font-size: 24rpx;
}

.summary-card {
  margin: 20rpx 30rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.summary-card rich-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

.toolbar {
  display: flex;
  justify-content: space-around;
  background: #FFFFFF;
  padding: 20rpx 0;
  margin: 20rpx 30rpx;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 20rpx;
}

.tool-item image {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}

.tool-item text {
  font-size: 24rpx;
  color: #1D1D1F;
  font-weight: 500;
}

.material-list {
  flex: 1;
  padding: 0 30rpx 40rpx;
  overflow: hidden;
}

.material-section {
  margin-top: 24rpx;
}

.material-section:first-child {
  margin-top: 0;
}

.material-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.material-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.material-icon text {
  color: inherit;
  font-size: 22rpx;
}

.material-info {
  flex: 1;
  min-width: 0;
}

.material-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #1D1D1F;
}

.material-meta {
  font-size: 22rpx;
  color: #86868B;
  margin-bottom: 6rpx;
}

.material-content {
  font-size: 24rpx;
  color: #777;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

