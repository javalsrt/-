<!-- 笔记编辑页 -->
<view class="page">
  <view class="header-info">
    <text class="header-title">课堂笔记</text>
    <text class="header-sub">记录课堂重点，AI自动生成标签</text>
  </view>

  <view class="note-editor card">
    <input class="note-title" placeholder="输入笔记标题（可选）" value="{{title}}" bindinput="onTitleInput" />
    <textarea class="note-content" placeholder="写下你的课堂笔记..." value="{{content}}" bindinput="onContentInput"
              maxlength="-1" auto-height></textarea>
    <view class="editor-actions">
      <view class="editor-btn" bindtap="saveNote">保存笔记</view>
      <view class="editor-btn secondary-btn" bindtap="clearNote">清空</view>
    </view>
  </view>

  <!-- 笔记列表 -->
  <view class="note-list">
    <view class="section-title">本课段笔记</view>
    <view wx:for="{{notes}}" wx:key="id" class="note-item card">
      <view class="note-item-header">
        <text class="note-item-title">{{item.title}}</text>
        <text class="note-item-time">{{item.createdAt}}</text>
      </view>
      <view class="note-item-content">{{item.content}}</view>
      <view class="note-item-tags" wx:if="{{item.aiTags}}">
        <text wx:for="{{item.aiTags}}" wx:key="index" class="tag tag-note">{{item}}</text>
      </view>
    </view>
    <view class="empty-state" wx:if="{{notes.length === 0}}">
      <text>还没有笔记</text>
    </view>
  </view>
</view>
