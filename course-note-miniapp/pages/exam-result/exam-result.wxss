.page {
  min-height: 100vh;
  background: #F5F5F7;
  padding: 20rpx 30rpx 60rpx;
}

.loading-page {
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-text {
  color: #86868B;
  font-size: 26rpx;
}

/* ===== 成绩概览 ===== */
.score-card {
  position: relative;
  border-radius: 28rpx;
  padding: 40rpx 30rpx 34rpx;
  margin-bottom: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-pass {
  background: linear-gradient(135deg, #0A84FF 0%, #5AC8FA 100%);
}

.card-fail {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF9500 100%);
}

.score-badge {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.25);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.score-main {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
}

.score-num {
  font-size: 96rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.1;
}

.score-total {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

.score-title {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.score-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.meta-dot {
  margin: 0 10rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* ===== 逐题明细 ===== */
.answer-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.a-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.a-no {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #F2F2F7;
  color: #1D1D1F;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.a-type {
  font-size: 22rpx;
  color: #86868B;
  background: #F5F5F7;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.a-score {
  margin-left: auto;
  font-size: 26rpx;
  font-weight: 700;
}

.score-right {
  color: #34C759;
}

.score-partial {
  color: #FF9500;
}

.score-wrong {
  color: #FF3B30;
}

.a-content {
  font-size: 28rpx;
  color: #1D1D1F;
  line-height: 1.6;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.a-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.a-label {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #86868B;
  line-height: 1.6;
}

.a-value {
  flex: 1;
  font-size: 26rpx;
  color: #1D1D1F;
  line-height: 1.6;
  word-break: break-all;
}

.value-empty {
  color: #C7C7CC;
}

.a-ref {
  color: #0A84FF;
}

/* ===== 点评 ===== */
.ai-comment,
.teacher-comment {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
}

.ai-comment {
  background: rgba(10, 132, 255, 0.06);
}

.teacher-comment {
  background: rgba(52, 199, 89, 0.08);
}

.comment-tag {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  background: #0A84FF;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tag-teacher {
  background: #34C759;
}

.comment-text {
  flex: 1;
  font-size: 24rpx;
  color: #1D1D1F;
  line-height: 1.6;
}

/* ===== 底部按钮 ===== */
.footer-btn {
  margin-top: 30rpx;
  text-align: center;
  padding: 26rpx;
  border-radius: 44rpx;
  background: #FFFFFF;
  color: #0A84FF;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
