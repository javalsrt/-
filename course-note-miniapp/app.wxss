
page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  background-color: #F5F5F7;
  color: #1D1D1F;
  font-size: 28rpx;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

.container {
  padding: 24rpx 30rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #1D1D1F;
  color: #FFFFFF;
  border-radius: 16rpx;
  padding: 22rpx 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  transition: opacity 0.2s;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  background: #FFFFFF;
  color: #1D1D1F;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 16rpx;
  padding: 20rpx 38rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
}

.btn-secondary:active {
  background: #F5F5F7;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 20rpx;
  letter-spacing: -0.02em;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #86868B;
}

.empty-state text {
  margin-top: 20rpx;
  font-size: 28rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-right: 8rpx;
  font-weight: 500;
}

.tag-photo {
  background: rgba(10, 132, 255, 0.1);
  color: #0A84FF;
}

.tag-note {
  background: rgba(255, 149, 0, 0.1);
  color: #FF9500;
}

.tag-external {
  background: rgba(175, 82, 222, 0.1);
  color: #AF52DE;
}

/* 通用输入框 */
.form-input,
.input-field {
  width: 100%;
  box-sizing: border-box;
  height: 80rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1D1D1F;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
}

.form-input:focus,
.input-field:focus {
  border-color: #0A84FF;
}

/* 页面头部标题区 */
.page-header {
  padding: 30rpx 30rpx 20rpx;
}

.page-header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.025em;
  display: block;
}

.page-header-sub {
  font-size: 24rpx;
  color: #86868B;
  margin-top: 8rpx;
  display: block;
}

